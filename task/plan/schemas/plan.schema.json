{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAG-план",
  "description": "Формат плана модуля plan: шаги-граф с зависимостями, полными ТЗ и критериями",
  "type": "object",
  "required": ["version", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "string",
      "description": "Каталог спеки (.specs/<id>-<slug>) или происхождение плана"
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": { "$ref": "#/definitions/step" }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["type", "title", "prompt"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["task", "research", "milestone"] },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["pending", "active", "done", "skipped", "failed"],
          "default": "pending"
        },
        "parent": {
          "type": ["string", "null"],
          "description": "Родительский шаг: ждёт завершения всех детей"
        },
        "deps": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Шаги, которые должны закрыться раньше этого"
        },
        "prompt": {
          "type": "string",
          "description": "Исчерпывающее самодостаточное ТЗ для исполнителя без контекста"
        },
        "criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Проверки: «command: ...» — исполняемая, иначе проверяемая агентом"
        },
        "result": { "type": ["string", "null"] },
        "task": {
          "type": "string",
          "description": "Метка задачи в tasks.md (например T3) для команды sync"
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Трассировка к требованиям R#"
        },
        "phase": { "type": "string", "description": "Фаза из tasks.md" }
      }
    }
  }
}
